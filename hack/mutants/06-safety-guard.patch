# Mutant 06-safety-guard: breaks the protection for "the safety guard (brief section 6)".
# Bug introduced: a context is accepted when its name looks local OR its server is loopback, instead of AND.
# hack/mutants.sh applies this in a scratch worktree and requires the tests
# below to FAIL, with output matching the expect pattern (so they fail for the
# right reason, not just any reason).
# unit-pkg: ./internal/guard/ ./cmd/podpeers/
# unit-run: TestCheckDefaultsToRefusal|TestCaptureRefusesNonLocalContextWithoutAnyRequest
# unit-expect: want allowed=false|want 2|made [0-9]+ API request
# e2e-run: TestE2E/guard_refuses
# e2e-expect: want refusal exit 2
diff --git a/internal/guard/guard.go b/internal/guard/guard.go
index 1bd639b..8cf7fd5 100644
--- a/internal/guard/guard.go
+++ b/internal/guard/guard.go
@@ -96,7 +96,7 @@ func Check(t Target, allowContext string) Decision {
 		return Decision{Reason: fmt.Sprintf(
 			"context %q has a loopback API server but sends requests through proxy-url %q, which can lead to any cluster; refusing. Re-run with --allow-context=%s only if you mean to modify that cluster",
 			t.Context, t.Proxy, t.Context)}
-	case name && loop:
+	case name || loop:
 		return Decision{Allowed: true, Context: t.Context, Reason: fmt.Sprintf(
 			"context %q is a local cluster (local tool name, loopback API server)", t.Context)}
 	case !name:
